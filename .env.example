# Copy to .env.local and set local secrets. API startup uses --env-file .env.local.
ADVISOR_API_KEY=replace-with-local-service-key
ADVISOR_ADMIN_API_KEY=replace-with-distinct-local-admin-key
ADVISOR_FINALIZATION_API_KEY=replace-with-distinct-finalization-key
ADVISOR_REQUEST_STORE_PATH=.api-state/requests.sqlite3
ADVISOR_HISTORY_INCREMENTAL_ROOT=data/artifacts/history_incremental
ADVISOR_HISTORY_BASELINE_SOURCE_ROOT=data/artifacts/history
ADVISOR_HISTORY_UPDATE_MODE=manual
ADVISOR_ENABLE_BACKTESTING=false

ADVISOR_UI_FASTAPI_URL=http://127.0.0.1:8000
ADVISOR_UI_STUDENT_API_URL=
ADVISOR_UI_COURSES_API_URL=
ADVISOR_UI_HISTORY_API_URL=
ADVISOR_UI_HISTORY_METHOD=GET
ADVISOR_UI_HTTP_TIMEOUT=20
# Service authentication defaults to ADVISOR_API_KEY; never commit real keys.
# ADVISOR_UI_SERVICE_KEY=
# ADVISOR_UI_BACKEND_TOKEN=
# ADVISOR_UI_INTEGRATION_CONTEXT_FILE=config/integration_context.json
